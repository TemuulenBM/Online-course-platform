# PostgreSQL
# ⚠️ Production-д хүчтэй нууц үг ашиглах!
DATABASE_URL=postgresql://ocp_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/online_course_platform

# MongoDB
# ⚠️ Production-д хүчтэй нууц үг ашиглах!
MONGODB_URI=mongodb://ocp_user:CHANGE_ME_STRONG_PASSWORD@localhost:27017/online_course_platform?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️ Production-д хүчтэй нууц үг ашиглах!
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
# ⚠️ ЗААВАЛ 32+ тэмдэгтийн random string ашиглах! Жишээ: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_48
JWT_REFRESH_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_48
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# Puppeteer (Certificates PDF)
CHROMIUM_PATH=/usr/bin/chromium-browser

# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_TOKEN_EXPIRY_SECONDS=3600
AGORA_WEBHOOK_SECRET=your-agora-webhook-secret

# Sentry — алдаа бүртгэл (https://sentry.io → Project Settings → DSN)
# Хоосон үлдээвэл Sentry идэвхгүй байна
SENTRY_DSN=

# App
APP_PORT=3001
APP_URL=http://localhost:3000
NODE_ENV=development
