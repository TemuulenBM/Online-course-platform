# PostgreSQL
DATABASE_URL=postgresql://ocp_user:ocp_password@localhost:5432/online_course_platform

# MongoDB
MONGODB_URI=mongodb://ocp_user:ocp_password@localhost:27017/online_course_platform?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ocp_password

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# Puppeteer (Certificates PDF)
CHROMIUM_PATH=/usr/bin/chromium-browser

# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_TOKEN_EXPIRY_SECONDS=3600
AGORA_WEBHOOK_SECRET=your-agora-webhook-secret

# App
APP_PORT=3001
APP_URL=http://localhost:3000
NODE_ENV=development
